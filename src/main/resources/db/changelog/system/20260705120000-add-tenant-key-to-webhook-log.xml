<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="20260705120000-add-tenant-key-to-webhook-log" author="iqkv">
        <addColumn tableName="webhook_log">
            <column name="tenant_key" type="varchar(255)" afterColumn="event_type"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="webhook_log" columnName="tenant_key"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
