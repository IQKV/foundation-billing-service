<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="20260422120100-create-subscriptions" author="iqkv">
        <createTable tableName="subscriptions" schemaName="public">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_key" type="VARCHAR(21)">
                <constraints nullable="false"/>
            </column>
            <column name="external_subscription_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_subscriptions_external_subscription_id"/>
            </column>
            <column name="external_customer_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_id" type="VARCHAR(255)"/>
            <column name="current_period_start" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="current_period_end" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="cancel_at_period_end" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="canceled_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_subscriptions_tenant_key" tableName="subscriptions" schemaName="public">
            <column name="tenant_key"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_subscriptions_tenant_key" tableName="subscriptions" schemaName="public"/>
            <dropTable tableName="subscriptions" schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
