<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260425120002-create-user-billing-settings" author="iqkv">
        <createTable tableName="user_billing_settings" schemaName="public">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_user_billing_settings_user_id"/>
            </column>
            <column name="external_customer_id" type="VARCHAR(255)"/>
            <column name="billing_email" type="VARCHAR(255)"/>
            <column name="company_name" type="VARCHAR(255)"/>
            <column name="billing_address" type="TEXT"/>
            <column name="tax_id" type="VARCHAR(64)"/>
            <column name="tax_id_type" type="VARCHAR(32)"/>
            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_user_billing_settings_user_id" tableName="user_billing_settings" schemaName="public">
            <column name="user_id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_user_billing_settings_user_id" tableName="user_billing_settings" schemaName="public"/>
            <dropTable tableName="user_billing_settings" schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
