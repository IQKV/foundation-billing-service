<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog-4.20.xsd">

    <changeSet id="20260701000002" author="iqkv">
        <comment>Add external_order_id column to subscriptions to store Lemon Squeezy order ID
            (LS refunds target order IDs, not charge IDs like Stripe.</comment>

        <addColumn tableName="subscriptions">
            <column name="external_order_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
