# IQ Key Value Billing Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billingservice
DB_USERNAME=svc_billing_dba
DB_PASSWORD=svc_billing_dba

# =============================================================================
# RabbitMQ Messaging Configuration
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=svc_billing_rmq
RABBITMQ_PASSWORD=svc_billing_rmq
MESSAGING_ENABLED=true

# =============================================================================
# Mail Configuration (MailHog for local dev — port 1025 SMTP, 8025 Web UI)
# For local profile: MAIL_PORT=1025 (MailHog). Base default: 587 (SMTP TLS).
# =============================================================================
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@iqkv.com
MAIL_FROM_NAME=IQ Key Value
MAIL_REPLY_TO=

# =============================================================================
# Stripe Payment Gateway Configuration
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# PostgreSQL container vars (used by postgres image directly)
# =============================================================================
POSTGRES_DB=billingservice
POSTGRES_USER=svc_billing_dba
POSTGRES_PASSWORD=svc_billing_dba

# =============================================================================
# JWT / Authentication
# In deployed (K8s) environments, set JWT_JWKS_URI so the service fetches the
# IAM public key dynamically — no mounted key copies, transparent key rotation.
# Leave JWT_JWKS_URI unset for local dev; the classpath PEM fallback is used.
# =============================================================================
# JWT_JWKS_URI=http://foundation-iam-service/.well-known/jwks.json
# JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# =============================================================================
# Single-Tenancy Mode Configuration
# =============================================================================
# Platform-wide operational mode: MULTI_TENANT (default) or SINGLE_TENANT
# All three services (IAM, Billing, Gateway) must use the same value
ROLLOUT_MODE=MULTI_TENANT

# Fallback billing contact email for SINGLE_TENANT mode
# Used when tenant.created bootstrap events have no ownerEmail
# Fallback chain: (1) ownerEmail from event → (2) this value → (3) null
DEFAULT_BILLING_EMAIL=
