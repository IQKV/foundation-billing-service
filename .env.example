# IQ Key Value Billing Service Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5434
DB_NAME=billing
DB_USERNAME=billing
DB_PASSWORD=billing

# =============================================================================
# RabbitMQ Messaging Configuration
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=billing
RABBITMQ_PASSWORD=billing
MESSAGING_ENABLED=true

# =============================================================================
# Stripe Payment Gateway Configuration
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# PostgreSQL container vars (used by postgres image directly)
# =============================================================================
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing

# =============================================================================
# Single-Tenancy Mode Configuration
# =============================================================================
# Platform-wide operational mode: MULTI_TENANT (default) or SINGLE_TENANT
# All three services (IAM, Billing, Gateway) must use the same value
ROLLOUT_MODE=MULTI_TENANT

# Fallback billing contact email for SINGLE_TENANT mode
# Used when tenant.created bootstrap events have no ownerEmail
# Fallback chain: (1) ownerEmail from event → (2) this value → (3) null
DEFAULT_BILLING_EMAIL=
